// Door watchdog: check if a door is open for the wrong duration.
func door_tester(int elevator) {
  for {
    // Wait for door to open
    await(() bool {
      return door([elevator]) == 1;   
    }, 100000);

    int start = now();
    
    await_or_exit(() bool {
      return door([elevator]) == 0;
    }, 10000);

    int diff = now() - start;

    if (diff < 2500 | diff > 3500) {
      exit(false);
    }
  }
}


