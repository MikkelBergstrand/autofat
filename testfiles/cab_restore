func process_cab_order(int elevator, int floorTarget) int {
  // Wait for the elevator to arrive at floor.
  await_or_exit(() bool {
    return (floor([elevator]) == floorTarget) & (moving([elevator]) == 0);  
  }, 20000);

  // Wait for the door to open at floor.
  await_or_exit(() bool {
    return (floor([elevator]) == floorTarget) & (door([elevator]) == 1);
  }, 5000);

  // Wait for the door to close at floor.
  await_or_exit(() bool {
    return door([elevator]) == 0 & floor([elevator]) == floorTarget;
  }, 5000);
  return 0;
}

